# 所有配置仅在服务端读取。不要使用 NEXT_PUBLIC_ 前缀，不要填写在聊天或 GitHub。
SUPABASE_URL=https://your-project.supabase.co
# Supabase Publishable key（或旧版 anon key）；应用不需要 service_role / secret key。
SUPABASE_PUBLISHABLE_KEY=
# Authentication > Users 中你本人账号的 User UID，与 set-owner.sql 中一致。
SUPABASE_OWNER_USER_ID=
# 首次部署及权限验证前保持 true；正式公开部署前由人工检查批准后设置 false。
DEPLOYMENT_LOCKED=true
# HTTPS 始终使用 true；本机合成测试可用 false。Vercel 强制 Secure cookie。
COOKIE_SECURE=true
# 可选：不配置也能提取原文、编辑与保存职业档案。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
